<script>
import * as THREE from 'three';

// ══════════════════════════════════════════════════════════
//  BACKGROUND WIRE MESH SCENE — fixed, full-viewport
// ══════════════════════════════════════════════════════════

const bgCanvas = document.getElementById('mesh-canvas');
const bgRenderer = new THREE.WebGLRenderer({ canvas: bgCanvas, alpha: true, antialias: true });
bgRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
bgRenderer.setSize(window.innerWidth, window.innerHeight);
bgRenderer.setClearColor(0x000000, 0);

const bgScene = new THREE.Scene();
const bgCamera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 200);
bgCamera.position.z = 10;

const lineMat = new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.22 });

function wireShape(geo) {
  const edges = new THREE.EdgesGeometry(geo);
  return new THREE.LineSegments(edges, lineMat.clone());
}

const bgShapes = [];

const geoPool = () => {
  const pick = Math.floor(Math.random() * 3);
  const size = 0.7 + Math.random() * 1.2;
  if (pick === 0) return new THREE.IcosahedronGeometry(size, 0);
  if (pick === 1) return new THREE.OctahedronGeometry(size, 0);
  return new THREE.TetrahedronGeometry(size, 0);
};

