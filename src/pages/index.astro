---
import '../styles/global.css';
import Sticker from '../components/Sticker.jsx';
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finnley Howald</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Permanent+Marker&display=swap" rel="stylesheet">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Questrial&display=swap" rel="stylesheet">
</head>
<body>

<header class="torn-paper-header">
    <nav class="scrap-nav">
        <ul class="flex justify-center gap-10 pt-12">
            <li><a href="#work" class="nav-label">Work</a></li>
            <li><a href="#projects" class="nav-label">Projects</a></li>
            <li><a href="#contact" class="nav-label">Contact</a></li>
        </ul>
    </nav>
</header>

    <main class="container">
        <section id="hero" class="hero-section">
            <div class="hero-grid">
				<div class="polaroid">
					<img src="/website/finnley4.jpg" alt="Finnley Howald" style="width: 100%; height: auto; object-fit: cover;" />
					
			</div>

                <div class="hero-content">
                    <h1 class="w-full"">
						<div>
							<span id="Finnley">Finnley Howald</span>
						</div>
						</h1>
                    <div class="bio-box">
						<div class="bio-content">
							<h5>
								Hello! I'm Finnley, a Computer Science student at McGill University. My interests include Visual Computing, Computational Biology, and AI. For more information about me, click the buttons below.
							</h5>
						</div>
					</div>

                    <div class="sticker-grid">
						<a href="/website/public/CV_Finnley_Howald.pdf" target="_blank" class="sticker-disk">
							<img src="/website/cv.png" alt="Download CV" />
						</a>

						<a href="https://linkedin.com/in/finnley-howald" target="_blank" class="sticker-disk">
							<img src="/website/linked.png" alt="LinkedIn Profile" />
						</a>

						<a href="https://github.com/Finnley111" target="_blank" class="sticker-disk">
							<img src="/website/git.png" alt="GitHub Profile" />
						</a>
					</div>
                </div>
            </div>
        </section>

        <section id="work" class="section-pad">
			<h2 class="section-header-scrap">Work Experience</h2>
            <div class="experience-list">
				<article class="experience-item work-card">
					<div class="exp-visual">
						<img src="/website/manifold_3d.png" alt="Manifold 3D Visualization" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
					</div>
					<div class="exp-details">
						<h3>Research Assistant @ Goodman Cancer Institute</h3>
						<div class="descr-box clean-inset">
							<p>A computational pipeline that utilizes deep learning and manifold learning to map the continuous progression of biological states within complex tissue environments. Moving beyond traditional discrete classification, this framework identifies morphological trajectories that provide a more granular understanding of disease development.</p>
						</div>
					</div>
				</article>

				<article class="experience-item work-card">
					<div class="exp-visual">
						<img src="/website/rl_mouse.png" alt="Manifold 3D Visualization" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
					</div>
					<div class="exp-details">
						<h3>Research Assistant @  McGill University - The Britt Lab</h3>
						<div class="descr-box clean-inset">
							<p>Used Reinforcement Learning frameworks to simulate complex decision-making behaviours in mice, developing an end-to-end pipeline for data pre-processing and synthetic dataset generation. By applying statistical modeling and parameter recovery analysis, I evaluated how different algorithmic extensions captured biological learning rates and reward-based choice patterns to improve model interpretability.</p>
						</div>
					</div>
				</article>

				<article class="experience-item work-card">
					<div class="exp-visual">
						<img src="/website/cc3dpreview4.gif" alt="Manifold 3D Visualization" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" /></div>
					<div class="exp-details">
						<h3>Research Assistant @ Goodman Cancer Institute</h3>
						<div class="descr-box clean-inset">
							<p>Developed biological models for breast cancer using Python and Compucell3D. Analyzed simulation results to aid in cancer research and sharing these findings with lab members.</p>
						</div>
					</div>
				</article>
			</div>
        </section>


        <section id="projects" class="section-pad">
            <h2 class="section-header-white-scrap">Projects</h2>
            <div class="projects-grid masonry-grid max-w-4xl mx-auto">
            <div class="project-card polaroid">
				<div class="polaroid-container">
					<img src="/website/WaterScene.png" alt="Manifold 3D Visualization" class="polaroid-img"/>
					<p class="polaroid-caption">Ray tracer using Taichi.</p>
				</div>
				</div>
                <div class="project-card polaroid">
			<div class="polaroid-container">
				<video 
					src="/website/bunny.mp4" 
					autoplay 
					muted 
					loop 
					playsinline 
					class="polaroid-img"
					style="object-fit: cover;"
				>
					Your browser does not support the video tag.
				</video>
				<p class="polaroid-caption">
					Mesh simplification using quadratic error.
				</p>
			</div>
		</div>

		<div class="project-card polaroid">
			<div class="polaroid-container">
				<img 
					src="/website/confusion_matrix.png" 
					alt="ML Model Validation" 
					class="polaroid-img"
					style="object-fit: cover;"
				/>
				<p class="polaroid-caption">
					Benchmarking scratch-built MLPs against CNNs on medical image classification.
				</p>
			</div>
		</div>
            </div>
        </section>


        <section id="contact" class="section-pad">
			<h2 class="section-header-scrap">Contact</h2>

			<div class="business-card">
				<div class="card-content">
					<div class="card-header">
						<h3>Finnley Howald</h3>
						<p class="subtitle">Computer Science @ McGill</p>
					</div>
					
					<div class="card-body">
						<div class="contact-item">
							<span class="label">E:</span>
							<span class="value">
							<a href="mailto:finnley.howald@gmail.com"  target="_blank"><strong>finnley.howald@gmail.com</strong></a></span>
						</div>
						<div class="contact-item">
							<span class="label">L:</span>
							<span class="value">
							<a href="https://linkedin.com/in/finnley-howald"  target="_blank"><strong>www.linkedin.com/in/finnley-howald</strong></a></span>
						</div>
					</div>
				</div>
			</div>
		</section>
    </main>
</body>
</html>