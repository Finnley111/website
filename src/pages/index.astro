---
import '../styles/global.css';
import Sticker from '../components/Sticker.jsx';
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finnley Howald</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Permanent+Marker&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="torn-paper-header">
    <nav class="scrap-nav">
        <ul class="flex justify-center gap-8 pt-6">
            <li><a href="#about" class="nav-label">About</a></li>
            <li><a href="#work" class="nav-label">Work</a></li>
            <li><a href="#projects" class="nav-label">Projects</a></li>
            <li><a href="#contact" class="nav-label">Contact</a></li>
        </ul>
    </nav>
</header>

    <main class="container">
        <section id="hero" class="hero-section">
            <div class="hero-grid">
				<div class="polaroid">
					<img src="/finnley.JPG" alt="Finnley Howald" style="width: 100%; height: auto; object-fit: cover;" />
					
			</div>

                <div class="hero-content">
                    <h1 class="flex flex-col items-center md:items-start mb-8 w-full" style="font-size: clamp(30px, 5vw, 90px);">
						<div class="ts mb-2">
							<div class="tw flex flex-nowrap justify-center md:justify-start gap-1">
							<div class="mlvx-0 tc"><div>F</div></div>
							<div class="mlvx-1 tc"><div>i</div></div>
							<div class="mlvx-2 tc"><div>n</div></div>
							<div class="mlvx-3 tc"><div>n</div></div>
							<div class="mlvx-4 tc"><div>l</div></div>
							<div class="mlvx-5 tc"><div>e</div></div>
							<div class="mlvx-6 tc"><div>y</div></div>
							</div>
						</div>

						<div class="ts">
							<div class="tw flex flex-wrap justify-center md:justify-start gap-1">
							<div class="mlvx-0 tc"><div>H</div></div>
							<div class="mlvx-3 tc"><div>o</div></div>
							<div class="mlvx-1 tc"><div>w</div></div>
							<div class="mlvx-4 tc"><div>a</div></div>
							<div class="mlvx-2 tc"><div>l</div></div>
							<div class="mlvx-6 tc"><div>d</div></div>
							</div>
						</div>
						</h1>
                    <div class="bio-box bio-scrap">
						<div class="bio-content">
							<h3>Bio</h3>
							<p>
								Hello! I'm Finnley, a Computer Science student at <strong>McGill University</strong>. My interests include <strong>Computer Graphics/Animation</strong>, <strong>Computational Biology</strong>, and <strong>AI</strong>. I have experience spanning from developing tools for Unreal Engine to creating biological models for cancer research.
							</p>
						</div>
					</div>

                    <div class="hero-ctas">
						<a href="/path-to-cv.pdf" class="sticker-btn">CV</a>
						<a href="https://linkedin.com/in/finnley-howald" class="sticker-btn">LinkedIn</a>
					</div>
                </div>
            </div>
        </section>

        <section id="work" class="section-pad">
            <h2 class="text-center mb-10" style="font-size: 40px;">
				<div class="ts">
					<div class="tw">
					<div class="mlvx-4 tc"><div>W</div></div><div class="mlvx-0 tc"><div>o</div></div><div class="mlvx-2 tc"><div>r</div></div><div class="mlvx-1 tc"><div>k</div></div>
					</div>
					<div class="tw ml-4">
					<div class="mlvx-3 tc"><div>E</div></div><div class="mlvx-5 tc"><div>x</div></div><div class="mlvx-6 tc"><div>p</div></div><div class="mlvx-0 tc"><div>e</div></div><div class="mlvx-4 tc"><div>r</div></div><div class="mlvx-2 tc"><div>i</div></div><div class="mlvx-1 tc"><div>e</div></div><div class="mlvx-3 tc"><div>n</div></div><div class="mlvx-5 tc"><div>c</div></div><div class="mlvx-6 tc"><div>e</div></div>
					</div>
				</div>
				</h2>
            <div class="experience-list">
                
                <article class="experience-item paper-cutout">
                    <div class="exp-visual placeholder-visual">Visual</div>
                    <div class="exp-details">
                        <h3>Software Intern @ Tech Co.</h3>
                        <div class="descr-box paper-cutout-inset">
                            <p>Description of responsibilities goes here...</p>
                        </div>
                    </div>
                </article>

                 <article class="experience-item paper-cutout">
                    <div class="exp-visual placeholder-visual">Visual</div>
                    <div class="exp-details">
                        <h3>Freelance Developer</h3>
                        <div class="descr-box paper-cutout-inset">
                            <p>Built various websites for local businesses...</p>
                        </div>
                    </div>
                </article>

				<article class="experience-item paper-cutout">
                    <div class="exp-visual placeholder-visual">Visual</div>
                    <div class="exp-details">
                        <h3>Freelance Developer</h3>
                        <div class="descr-box paper-cutout-inset">
                            <p>Built various websites for local businesses...</p>
                        </div>
                    </div>
                </article>
                </div>
        </section>


        <section id="projects" class="section-pad">
            <h2 class="text-center mb-10" style="font-size: 40px;">
				<div class="ts">
					<div class="tw">
					<div class="mlvx-2 tc"><div>P</div></div><div class="mlvx-4 tc"><div>r</div></div><div class="mlvx-0 tc"><div>o</div></div><div class="mlvx-6 tc"><div>j</div></div><div class="mlvx-1 tc"><div>e</div></div><div class="mlvx-3 tc"><div>c</div></div><div class="mlvx-5 tc"><div>t</div></div><div class="mlvx-0 tc"><div>s</div></div>
					</div>
				</div>
				</h2>
            <div class="projects-grid">
                <div class="project-card polaroid">
                    <div class="placeholder-visual" style="height: 200px;">Visual</div>
                </div>
                <div class="project-card polaroid">
                    <div class="placeholder-visual" style="height: 200px;">Visual</div>
                </div>
                <div class="project-card polaroid">
                    <div class="placeholder-visual" style="height: 200px;">Visual</div>
                </div>
                <div class="project-card polaroid">
                    <div class="placeholder-visual" style="height: 200px;">Visual</div>
                </div>
            </div>
        </section>


        <section id="contact" class="section-pad">
            <h2 class="text-center mb-10" style="font-size: 40px;">
				<div class="ts">
					<div class="tw">
					<div class="mlvx-5 tc"><div>C</div></div><div class="mlvx-1 tc"><div>o</div></div><div class="mlvx-3 tc"><div>n</div></div><div class="mlvx-6 tc"><div>t</div></div><div class="mlvx-0 tc"><div>a</div></div><div class="mlvx-4 tc"><div>c</div></div><div class="mlvx-2 tc"><div>t</div></div>
					</div>
				</div>
				</h2>
            <div class="contact-sheet paper-cutout">
                <div class="contact-row">
                    <span class="label">Phone Number</span>
                    <span class="value wavy-line-placeholder">555-0192</span>
                </div>
                <div class="contact-row">
                    <span class="label">Email</span>
                    <span class="value wavy-line-placeholder">finnley.howald@gmail.com</span>
                </div>
                <div class="contact-row">
                    <span class="label">LinkedIn</span>
                    <span class="value wavy-line-placeholder">www.linkedin.com/in/finnley-howald</span>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
